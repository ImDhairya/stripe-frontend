# ==============================================================================
# PayGate Frontend Environment Variables
# ==============================================================================

# Stripe Publishable Key (Test Mode)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:3000

# Evaluator Sandbox Toggle (true = direct landing, auto-admin, assessor gateway; false = standard production auth)
VITE_EVALUATOR_MODE=true

